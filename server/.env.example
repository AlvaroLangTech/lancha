# SENIOR (2026-08-01): variaveis de ambiente do backend da Lancha Beju.
# Copiar pra .env (NAO commitar .env de verdade - ja fica no .gitignore
# igual o padrao do Viver Bem).

PORT=3101
NODE_ENV=development

# Banco de dados: em dev, se DB_TYPE nao for definido, usa SQLite local
# (dev.sqlite) automaticamente - nao precisa de nada configurado pra rodar
# localmente. Em producao, definir DB_TYPE=postgres e DB_URL (Supabase ou
# qualquer Postgres).
DB_TYPE=better-sqlite3
DB_DATABASE=dev.sqlite
# DB_TYPE=postgres
# DB_URL=postgresql://usuario:senha@host:5432/postgres

# JWT do login do painel admin (gerar uma string aleatoria longa em producao)
JWT_SECRET=troque-isso-em-producao
JWT_EXPIRES_IN=7d

# Asaas (pagamentos) - conta propria do CNPJ da Lancha Beju, NAO a mesma do
# Viver Bem. Pegar em asaas.com > Integracoes > API Key.
ASAAS_API_KEY=
ASAAS_ENV=sandbox

# Resend (envio de email do codigo de verificacao) - mesmo provedor ja usado
# no Viver Bem, pode ser a mesma conta Resend com um remetente novo.
RESEND_API_KEY=
EMAIL_FROM="Lancha Bêju <reservas@lanchabeju.com.br>"

# Origem do frontend liberada no CORS
FRONTEND_URL=http://localhost:3000

# SENIOR (2026-08-02, pedido do Alvaro: "cade a ia? tem que ser o bot
# integrado 100%, automatico"): IA do assistente de vendas do site
# (SiteChatWidget.tsx -> POST /chat/message -> ChatService). Mesma API que o
# bot de WhatsApp do Laboratório Viver Bem já usa (Groq, console.groq.com >
# API Keys) - pode reaproveitar a mesma chave ou criar uma nova só pra Lancha.
# Sem essa variável configurada, o chat do site continua funcionando (menu de
# botões, FAQ, fluxo de reserva completo), só a resposta a perguntas livres
# cai num texto padrão pedindo pra falar no WhatsApp em vez de responder com
# IA de verdade.
GROQ_API_KEY=
